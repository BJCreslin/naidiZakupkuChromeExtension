{
  "name": "naidiZakupku",
  "description": "Маленький помощник в больших закупках",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zakupki.gov.ru/*",
    "https://naidizakupku.ru/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Найди закупку!"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zakupki.gov.ru/*"
      ],
      "js": [
        "application.js"
      ],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style/*"],
      "matches": ["https://zakupki.gov.ru/*"]
    }
  ]
}
